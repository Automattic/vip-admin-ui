{
	"plugins": [
		"@wordpress/theme/stylelint-plugins/no-unknown-ds-tokens",
		"@wordpress/theme/stylelint-plugins/no-setting-wpds-custom-properties",
		"@wordpress/theme/stylelint-plugins/no-token-fallback-values"
	],
	"rules": {
		"plugin-wpds/no-unknown-ds-tokens": true,
		"plugin-wpds/no-setting-wpds-custom-properties": true,
		"plugin-wpds/no-token-fallback-values": true,
		"color-no-hex": true,
		"color-named": "never",
		"function-disallowed-list": [
			"rgb",
			"rgba",
			"hsl",
			"hsla"
		]
	},
	"overrides": [
		{
			"comment": "The supplemental token and palette files are the only places raw hex values are allowed.",
			"files": [
				"src/styles/tokens.css",
				"src/styles/palette.css"
			],
			"rules": {
				"color-no-hex": null
			}
		}
	]
}
